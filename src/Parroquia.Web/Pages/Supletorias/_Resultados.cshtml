@model Parroquia.Web.Pages.Supletorias.IndexModel
@{
    var r = Model.Resultado;
}

<p class="text-muted" aria-live="polite">@r.Total.ToString("N0") partidas supletorias</p>

<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th class="col-num">Libro</th><th class="col-num">Folio</th><th class="col-num">Partida</th>
            <th>Fecha del asiento</th><th>Sacramento</th><th>Persona</th><th>Testigo</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var f in r.Items)
    {
        var s = f.Supletoria;
        <tr class="@(s.Anulado ? "text-decoration-line-through text-muted" : "")">
            <td class="col-num">@s.Libro</td>
            <td class="col-num">@s.Folio</td>
            <td class="col-num">@s.Partida</td>
            <td class="text-nowrap">@s.Fecha</td>
            <td>@f.Sacramento</td>
            <td>
                @if (f.RutaDetalle is not null)
                {
                    <a href="@Url.Content("~" + f.RutaDetalle)">@f.Persona</a>
                }
                else
                {
                    @f.Persona
                }
            </td>
            <td>@s.Testigo@(string.IsNullOrWhiteSpace(s.ParentescoTestigo) ? "" : $" ({s.ParentescoTestigo})")</td>
            <td>@if (s.Anulado) { <span class="badge text-bg-secondary">Anulada</span> }</td>
        </tr>
    }
    @if (r.Items.Count == 0)
    {
        <tr><td colspan="8" class="text-muted">@(Model.HayFiltros ? "No hay partidas supletorias con esos datos." : "Aún no hay partidas en el Libro de Supletorias.")</td></tr>
    }
    </tbody>
</table>
</div>

@if (r.TotalPaginas > 1)
{
    <nav aria-label="Páginas" hx-boost="true" hx-target="#resultados" hx-push-url="true">
        <ul class="pagination">
            <li class="page-item @(r.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="/Supletorias/Index" asp-route-sacramento="@Model.Sacramento" asp-route-libro="@Model.Libro"
                   asp-route-folio="@Model.Folio" asp-route-desde="@Model.Desde" asp-route-hasta="@Model.Hasta"
                   asp-route-anuladas="@(Model.Anuladas ? "true" : null)" asp-route-pagina="@(r.PaginaActual - 1)">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Página @r.PaginaActual de @r.TotalPaginas</span></li>
            <li class="page-item @(r.PaginaActual >= r.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-page="/Supletorias/Index" asp-route-sacramento="@Model.Sacramento" asp-route-libro="@Model.Libro"
                   asp-route-folio="@Model.Folio" asp-route-desde="@Model.Desde" asp-route-hasta="@Model.Hasta"
                   asp-route-anuladas="@(Model.Anuladas ? "true" : null)" asp-route-pagina="@(r.PaginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
