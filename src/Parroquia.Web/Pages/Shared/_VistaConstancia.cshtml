@using Parroquia.Aplicacion.Constancias
@model Parroquia.Web.Presentacion.VistaConstanciaModel
@functions {
    static string Alinear(Alineacion a) => a switch
    {
        Alineacion.Izquierda => "text-start",
        Alineacion.Derecha => "text-end",
        _ => "text-center",
    };
}
@{
    var d = Model.Documento;
}

@* Aproximación en pantalla de la hoja carta: el PDF usa este mismo modelo de documento. *@
<div class="constancia-hoja bg-white border shadow-sm mx-auto p-4 p-md-5" aria-label="Vista previa de la constancia">
    <div class="d-flex align-items-center mb-2">
        <div style="width: 130px" class="flex-shrink-0">
            @if (Model.LogoUrl is not null)
            {
                <img src="@Model.LogoUrl" alt="Logo de la parroquia" class="img-fluid" />
            }
        </div>
        <div class="ps-3 fw-bold" style="font-family: 'Liberation Serif', 'Times New Roman', serif; font-size: .85rem">
            @foreach (var linea in d.Membrete)
            {
                <div>@linea</div>
            }
        </div>
    </div>
    <hr class="border-2 opacity-100 my-1" />
    <hr class="border-1 opacity-100 mt-1 mb-3" />

    <div class="text-center mb-3">
        <span class="d-inline-block border border-dark rounded-3 px-4 py-1 fw-bold fs-5">@d.Titulo</span>
    </div>

    @foreach (var p in d.Cuerpo.Append(d.Cierre))
    {
        <p class="@Alinear(p.Alineacion) mb-2 @(p.LineaInferior ? "border-bottom border-dark mx-5 pb-1" : "")"
           style="margin-top: @(p.EspacioAntes)px">
            @foreach (var s in p.Segmentos)
            {
                <span class="@(s.Negrita ? "fw-bold" : "") @(s.Subrayado ? "text-decoration-underline" : "")">@s.Texto</span>
            }
        </p>
    }

    <div class="text-end" style="margin-top: @(d.Firmante.EspacioAntes)px">
        <div class="d-inline-block text-center fw-bold">
            <div>@d.Firmante.ATexto()</div>
            <div>@d.TituloFirmante</div>
        </div>
    </div>
</div>
