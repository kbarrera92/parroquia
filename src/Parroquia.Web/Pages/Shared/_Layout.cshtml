@using Microsoft.AspNetCore.Authorization
@using Parroquia.Aplicacion.Seguridad
@inject IAuthorizationService Autorizacion
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    async Task<bool> Puede(string permiso) => autenticado && (await Autorizacion.AuthorizeAsync(User, permiso)).Succeeded;

    var verLibros = await Puede(Permisos.RegistrosBuscar);
    var verCatalogos = await Puede(Permisos.CatalogosGestionar);
    var verConfiguracion = await Puede(Permisos.Configuracion);
    var verHistorial = await Puede(Permisos.AuditoriaVer);
    var verAdministracion = verCatalogos || verConfiguracion || verHistorial;
}
<!DOCTYPE html>
<html lang="es-GT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Parroquial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Parroquia San Bartolomé</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Búsqueda</a></li>
                        @if (verLibros)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Comunion/Index">Comuniones</a></li>
                        }
                        @if (verAdministracion)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu">
                                    @if (verConfiguracion)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Admin/Configuracion">Configuración</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Parrocos">Párroco</a></li>
                                    }
                                    @if (verCatalogos)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Admin/Ministros">Ministros</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Tratamientos">Tratamientos</a></li>
                                    }
                                    @if (verHistorial)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Historial">Historial y bitácora</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <span class="navbar-text me-3">@User.Identity.Name</span>
                    <a class="btn btn-outline-light btn-sm" asp-page="/Cuenta/Logout">Cerrar sesión</a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
