@model string?
@* Una fila de la lista de testigos. Todas comparten el nombre "Input.Testigos": el orden de la lista es el del formulario. *@
<div class="input-group mb-2" data-fila>
    <input name="Input.Testigos" value="@Model" class="form-control" maxlength="150" autocomplete="off" aria-label="Nombre del testigo" />
    <button type="button" class="btn btn-outline-secondary" data-quitar-fila aria-label="Quitar este testigo">Quitar</button>
</div>
