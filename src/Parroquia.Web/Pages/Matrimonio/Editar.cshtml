@page "{id:long?}"
@model Parroquia.Web.Pages.Matrimonio.EditarModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo registro de Matrimonio" : "Editar registro de Matrimonio";
    var focoNombres = Model.ContinuaSerie;
}

<div class="mt-4">
    <h1 class="h3">@(Model.EsNuevo ? "Nuevo registro" : "Editar registro") · Matrimonio</h1>
    <p class="text-muted">
        Escriba los datos tal como están en el libro. Use <kbd>Tab</kbd> para pasar de un campo al siguiente
        @if (Model.EsNuevo)
        {
            <text>y <kbd>Enter</kbd> para guardar y abrir un registro nuevo con el mismo libro.</text>
        }
        else
        {
            <text>y <kbd>Enter</kbd> para guardar.</text>
        }
    </p>

    @if (Model.Mensaje is not null)
    {
        <div class="alert alert-success" role="status">@Model.Mensaje</div>
    }
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @Model.Error
            @if (Model.Id is not null)
            {
                <a asp-page="/Matrimonio/Detalle" asp-route-id="@Model.Id" class="alert-link">Abrir el registro actualizado</a>
            }
        </div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (Model.Duplicados.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Ya existe un registro parecido.</strong> Revise si es el mismo antes de guardar:
            <ul class="mb-2">
                @foreach (var d in Model.Duplicados)
                {
                    <li>
                        <a asp-page="/Matrimonio/Detalle" asp-route-id="@d.Id" target="_blank" rel="noopener">@(d.Nombre.Length == 0 ? "(sin nombres)" : d.Nombre)</a>
                        · libro @d.Libro, folio @d.Folio, partida @d.Partida · @d.Fecha
                    </li>
                }
            </ul>
            Si es otro matrimonio, use «Guardar de todos modos», al final del formulario.
        </div>
    }

    <form method="post" id="formulario" class="row g-3">
        <input asp-for="Input.Version" type="hidden" />

        @if (Model.EsNuevo)
        {
            <div class="col-12">
                <input asp-for="Input.AsientoNuevo" type="hidden" />
                <ul class="nav nav-pills">
                    <li class="nav-item">
                        <a class="nav-link @(Model.Input.AsientoNuevo ? "" : "active")" asp-page="Editar">Transcribir de un libro físico</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.Input.AsientoNuevo ? "active" : "")" asp-page="Editar" asp-route-modo="sistema">Asiento nuevo (numera el sistema)</a>
                    </li>
                </ul>
                <span asp-validation-for="Input.AsientoNuevo" class="text-danger"></span>
            </div>
        }

        @if (Model.EsNuevo && Model.Input.AsientoNuevo)
        {
            <div class="col-12">
                @if (Model.Proximo is { } p)
                {
                    <div class="alert alert-info mb-0" role="status">
                        El sistema asignará el libro, folio y partida al guardar. Próximo número (orientativo):
                        libro <strong>@p.Libro</strong>, folio <strong>@p.Folio</strong>, partida <strong>@p.Partida</strong>.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        No hay un libro digital abierto para Matrimonio. Pida al Administrador que lo abra
                        (Administración → Libros digitales).
                    </div>
                }
            </div>
        }
        else
        {
            var soloLectura = Model.AsientoDelSistema;
            <div class="col-md-2">
                <label asp-for="Input.Libro" class="form-label">Libro</label>
                <input asp-for="Input.Libro" class="form-control" maxlength="30" autofocus="@(!focoNombres && !soloLectura)" autocomplete="off" readonly="@soloLectura" />
                <span asp-validation-for="Input.Libro" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Folio" class="form-label">Folio</label>
                <input asp-for="Input.Folio" class="form-control" maxlength="30" autocomplete="off" readonly="@soloLectura" />
                <span asp-validation-for="Input.Folio" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Partida" class="form-label">Partida</label>
                <input asp-for="Input.Partida" class="form-control" maxlength="30" autocomplete="off" readonly="@soloLectura" />
                <span asp-validation-for="Input.Partida" class="text-danger"></span>
            </div>
            @if (soloLectura)
            {
                <div class="col-md-6 align-self-end form-text">
                    Asiento numerado por el sistema: libro, folio y partida no se cambian. Si hay un error, anule el registro y asiente de nuevo.
                </div>
            }
        }
        <div class="col-md-3">
            <label asp-for="Input.FechaMatrimonio" class="form-label">Fecha del matrimonio</label>
            <input asp-for="Input.FechaMatrimonio" class="form-control" maxlength="10" placeholder="21/04/2007" autocomplete="off" aria-describedby="ayuda-fecha" />
            <div id="ayuda-fecha" class="form-text">Día/mes/año (21/04/2007), mes/año (04/2007) o solo el año (2007).</div>
            <span asp-validation-for="Input.FechaMatrimonio" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.LugarCelebracion" class="form-label">Lugar de celebración</label>
            <input asp-for="Input.LugarCelebracion" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.LugarCelebracion" class="text-danger"></span>
        </div>

        <div class="col-12"><h2 class="h5 mt-2 mb-0">Esposo</h2></div>
        <div class="col-md-2">
            <label asp-for="Input.Esposo.Tratamiento" class="form-label">Tratamiento</label>
            <select asp-for="Input.Esposo.Tratamiento" asp-items="Model.OpcionesTratamiento(Model.Input.Esposo.Tratamiento)" class="form-select">
                <option value="">(ninguno)</option>
            </select>
            <span asp-validation-for="Input.Esposo.Tratamiento" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Esposo.Nombres" class="form-label">Nombres</label>
            <input asp-for="Input.Esposo.Nombres" class="form-control" maxlength="150" autofocus="@focoNombres" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.Nombres" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Esposo.Apellidos" class="form-label">Apellidos</label>
            <input asp-for="Input.Esposo.Apellidos" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.Apellidos" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Esposo.Edad" class="form-label">Edad</label>
            <input asp-for="Input.Esposo.Edad" class="form-control" maxlength="3" inputmode="numeric" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.Edad" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposo.OriginarioDe" class="form-label">Originario de</label>
            <input asp-for="Input.Esposo.OriginarioDe" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.OriginarioDe" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposo.FeligresDe" class="form-label">Feligrés de</label>
            <input asp-for="Input.Esposo.FeligresDe" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.FeligresDe" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposo.Padre" class="form-label">Padre</label>
            <input asp-for="Input.Esposo.Padre" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.Padre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposo.Madre" class="form-label">Madre</label>
            <input asp-for="Input.Esposo.Madre" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposo.Madre" class="text-danger"></span>
        </div>

        <div class="col-12"><h2 class="h5 mt-2 mb-0">Esposa</h2></div>
        <div class="col-md-2">
            <label asp-for="Input.Esposa.Tratamiento" class="form-label">Tratamiento</label>
            <select asp-for="Input.Esposa.Tratamiento" asp-items="Model.OpcionesTratamiento(Model.Input.Esposa.Tratamiento)" class="form-select">
                <option value="">(ninguno)</option>
            </select>
            <span asp-validation-for="Input.Esposa.Tratamiento" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Esposa.Nombres" class="form-label">Nombres</label>
            <input asp-for="Input.Esposa.Nombres" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.Nombres" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Esposa.Apellidos" class="form-label">Apellidos</label>
            <input asp-for="Input.Esposa.Apellidos" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.Apellidos" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Esposa.Edad" class="form-label">Edad</label>
            <input asp-for="Input.Esposa.Edad" class="form-control" maxlength="3" inputmode="numeric" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.Edad" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposa.OriginarioDe" class="form-label">Originaria de</label>
            <input asp-for="Input.Esposa.OriginarioDe" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.OriginarioDe" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposa.FeligresDe" class="form-label">Feligresa de</label>
            <input asp-for="Input.Esposa.FeligresDe" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.FeligresDe" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposa.Padre" class="form-label">Padre</label>
            <input asp-for="Input.Esposa.Padre" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.Padre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Esposa.Madre" class="form-label">Madre</label>
            <input asp-for="Input.Esposa.Madre" class="form-control" maxlength="150" autocomplete="off" />
            <span asp-validation-for="Input.Esposa.Madre" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label" id="etiqueta-testigos">Testigos</label>
            <div id="testigos" data-filas role="group" aria-labelledby="etiqueta-testigos">
                @foreach (var testigo in Model.Input.Testigos)
                {
                    <partial name="_FilaTestigo" model="testigo" />
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-agregar-fila
                    hx-get="@Url.Page("/Matrimonio/Editar", "FilaTestigo")" hx-target="#testigos" hx-swap="beforeend">
                Agregar testigo
            </button>
            <div class="form-text">En el orden del libro. Las filas vacías se ignoran.</div>
            <span asp-validation-for="Input.Testigos" class="text-danger d-block"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Ministro" class="form-label">Ministro (firma)</label>
            <input asp-for="Input.Ministro" class="form-control" maxlength="150" list="lista-ministros" autocomplete="off" />
            <datalist id="lista-ministros">
                @foreach (var m in Model.Ministros)
                {
                    <option value="@m"></option>
                }
            </datalist>
            <div class="form-text">Elija de la lista o escriba otro nombre.</div>
            <span asp-validation-for="Input.Ministro" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Input.NotasMarginales" class="form-label">Notas marginales (opcional)</label>
            <textarea asp-for="Input.NotasMarginales" class="form-control" rows="2" maxlength="2000"></textarea>
            <span asp-validation-for="Input.NotasMarginales" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="Input.Revisar" class="form-check-input" />
                <label asp-for="Input.Revisar" class="form-check-label">Revisar este registro (dato dudoso o ilegible en el libro)</label>
            </div>
        </div>
        <div class="col-md-8">
            <label asp-for="Input.MotivoRevision" class="form-label">Motivo de la revisión</label>
            <input asp-for="Input.MotivoRevision" class="form-control" maxlength="500" autocomplete="off" />
            <span asp-validation-for="Input.MotivoRevision" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex flex-wrap gap-2">
            @if (Model.EsNuevo)
            {
                @* Primer botón = el que se activa con Enter. *@
                <button type="submit" name="accion" value="nuevo" class="btn btn-primary">Guardar y nuevo</button>
                <button type="submit" name="accion" value="guardar" class="btn btn-outline-primary">Guardar</button>
                <a asp-page="/Matrimonio/Index" class="btn btn-link">Cancelar</a>
            }
            else
            {
                <button type="submit" name="accion" value="guardar" class="btn btn-primary">Guardar cambios</button>
                <a asp-page="/Matrimonio/Detalle" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
            }
            @if (Model.Duplicados.Count > 0)
            {
                @* Al final a propósito: Enter nunca debe saltarse el aviso de duplicados. *@
                <button type="submit" name="accion" value="@(Model.AccionPrevia)-forzar" class="btn btn-warning ms-auto">Guardar de todos modos</button>
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/filas-dinamicas.js" asp-append-version="true"></script>
}
