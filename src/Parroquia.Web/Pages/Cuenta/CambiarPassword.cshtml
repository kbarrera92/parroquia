@page
@model Parroquia.Web.Pages.Cuenta.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Cambiar contraseña</h1>
        @if (Model.Obligatorio)
        {
            <div class="alert alert-warning" role="alert">Su contraseña es temporal. Debe cambiarla para continuar.</div>
        }
        <p class="text-muted">
            Use al menos @Model.Minimo caracteres. Una frase fácil de recordar es mejor que una clave con símbolos
            (por ejemplo, cuatro palabras sueltas). No use datos de la parroquia ni su usuario.
        </p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="PasswordActual" class="form-label">Contraseña actual</label>
                <input asp-for="PasswordActual" class="form-control" autofocus autocomplete="current-password" />
                <span asp-validation-for="PasswordActual" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PasswordNueva" class="form-label">Contraseña nueva</label>
                <input asp-for="PasswordNueva" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordNueva" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PasswordConfirmar" class="form-label">Repetir contraseña nueva</label>
                <input asp-for="PasswordConfirmar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordConfirmar" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
        </form>
    </div>
</div>
