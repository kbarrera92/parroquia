@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="mt-4">
    <h1 class="h3">Búsqueda de registros</h1>
    <p class="text-muted">Escriba nombres y/o apellidos; se busca en todos los libros, sin importar tildes ni mayúsculas.</p>

    <form method="get" class="row g-2 align-items-end mb-3"
          hx-get="@Url.Page("/Index")" hx-target="#resultados" hx-push-url="true"
          hx-trigger="submit, input delay:300ms from:#texto, change from:#filtros">
        <div class="col-md-8">
            <label for="texto" class="form-label visually-hidden">Nombres y apellidos</label>
            <input id="texto" name="texto" value="@Model.Texto" class="form-control form-control-lg" autofocus autocomplete="off"
                   placeholder="Por ejemplo: hidalgo arevalo" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-lg">Buscar</button>
        </div>
        <div class="col-12">
            <details id="filtros" open="@Model.HayFiltros">
                <summary>Filtros</summary>
                <div class="row g-2 mt-1">
                    <div class="col-md-3">
                        <label for="sacramento" class="form-label">Sacramento</label>
                        <select id="sacramento" name="sacramento" class="form-select">
                            <option value="">Todos</option>
                            @foreach (var m in Model.Modulos)
                            {
                                <option value="@m.Clave" selected="@(m.Clave == Model.Sacramento)">@m.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="anioDesde" class="form-label">Año desde</label>
                        <input id="anioDesde" name="anioDesde" type="number" min="1500" class="form-control" value="@Model.AnioDesde" />
                    </div>
                    <div class="col-md-2">
                        <label for="anioHasta" class="form-label">Año hasta</label>
                        <input id="anioHasta" name="anioHasta" type="number" min="1500" class="form-control" value="@Model.AnioHasta" />
                    </div>
                    <div class="col-md-2">
                        <label for="libro" class="form-label">Libro</label>
                        <input id="libro" name="libro" class="form-control" maxlength="30" value="@Model.Libro" />
                    </div>
                    <div class="col-md-2">
                        <label for="folio" class="form-label">Folio</label>
                        <input id="folio" name="folio" class="form-control" maxlength="30" value="@Model.Folio" />
                    </div>
                </div>
            </details>
        </div>
    </form>

    <div id="resultados" aria-live="polite">
        <partial name="_ResultadosGlobales" model="Model" />
    </div>
</div>
