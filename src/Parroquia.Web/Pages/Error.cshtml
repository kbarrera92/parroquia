@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error.</h1>
<p class="lead">No se pudo completar la operación. Intente de nuevo; si persiste, avise al desarrollador.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}
